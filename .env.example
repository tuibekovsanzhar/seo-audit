# OPTIONAL PRIVATE CONFIGURATION - placeholders only. No credentials are supplied.
# Copy this file to .env in your own extraction and edit privately, or export these variables.
# Leave provider credentials unset for the offline demo.
# MAYA_AUDIT_FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY
# MAYA_AUDIT_DATAFORSEO_LOGIN=YOUR_DATAFORSEO_LOGIN
# MAYA_AUDIT_DATAFORSEO_PASSWORD=YOUR_DATAFORSEO_PASSWORD
# MAYA_AUDIT_CRUX_API_KEY=YOUR_OPTIONAL_GOOGLE_CRUX_KEY
# MAYA_AUDIT_ENV_FILE=/absolute/path/to/your/private/configuration.env
# MAYA_AUDIT_HOME=/absolute/path/to/your/private/maya-data
# Optional spending/retention controls: retain defaults unless the owner authorizes changes.
# MAYA_AUDIT_FIRECRAWL_DAILY_CREDITS=YOUR_APPROVED_LIMIT
# MAYA_AUDIT_FIRECRAWL_USD_PER_CREDIT=YOUR_CONFIGURED_RATE
# MAYA_AUDIT_FIRECRAWL_ZERO_DATA_RETENTION=on
# MAYA_AUDIT_DATAFORSEO_DAILY_USD=YOUR_APPROVED_LIMIT
# MAYA_AUDIT_DATAFORSEO_AUDIT_CAP_USD=YOUR_APPROVED_LIMIT
# MAYA_AUDIT_DATAFORSEO_CONFIRM_ABOVE_USD=YOUR_CONFIRMATION_THRESHOLD
