# Maya Audit settings. Copy this file to .env (never commit .env) and fill in only what you use.
# Every value is empty here; an empty value means "not set" and the default applies.
# Lines marked [env] are read from the shell environment only (export them); the others are also read from .env.

# --- Provider credentials (leave empty for the offline demo) -------------------------------------------------
# Firecrawl API key: the page reader for sites that refuse Maya's own crawler (paid in credits).
MAYA_AUDIT_FIRECRAWL_API_KEY=
# DataForSEO login (account e-mail): backlinks and search-data panels (paid).
MAYA_AUDIT_DATAFORSEO_LOGIN=
# DataForSEO API password (from the DataForSEO dashboard, not your account password).
MAYA_AUDIT_DATAFORSEO_PASSWORD=
# Google CrUX API key: real-user Core Web Vitals (free quota).
MAYA_AUDIT_CRUX_API_KEY=
# [env] Google API key for PageSpeed Insights, used with `maya_audit crawl --pagespeed`.
MAYA_AUDIT_GOOGLE_API_KEY=
# [env] Bing Webmaster Tools API key, used with `maya_audit crawl --bing-site-url`.
MAYA_AUDIT_BING_API_KEY=
# [env] Google Search Console OAuth access token, used with `maya_audit crawl --gsc-site-url`.
MAYA_AUDIT_GSC_TOKEN=

# --- Firecrawl behaviour and spending ------------------------------------------------------------------------
# "off" stops Firecrawl being the page reader of every audit even when a key is set (default: on).
MAYA_AUDIT_FIRECRAWL=
# Most Firecrawl credits this computer may spend per day (default: 10000).
MAYA_AUDIT_FIRECRAWL_DAILY_CREDITS=
# Dollar price of one Firecrawl credit, to show costs in USD (default: credits only).
MAYA_AUDIT_FIRECRAWL_USD_PER_CREDIT=
# "off" stops asking Firecrawl for zero data retention, for an account without it (default: on).
MAYA_AUDIT_FIRECRAWL_ZERO_DATA_RETENTION=
# [env] Seconds of the audit's time budget allowed per page the reader reads (default: 8).
MAYA_AUDIT_READER_SECONDS_PER_PAGE=

# --- DataForSEO spending limits (USD) ------------------------------------------------------------------------
# Most DataForSEO may cost per day on this computer (default: 20).
MAYA_AUDIT_DATAFORSEO_DAILY_USD=
# Most one audit may spend on DataForSEO (default: 5).
MAYA_AUDIT_DATAFORSEO_AUDIT_CAP_USD=
# A plan costing more than this asks for confirmation before it runs (default: 2).
MAYA_AUDIT_DATAFORSEO_CONFIRM_ABOVE_USD=

# --- Where things live ---------------------------------------------------------------------------------------
# [env] Folder for history, saved reports and ledgers (default: ~/.maya-audit).
MAYA_AUDIT_HOME=
# Path of the private settings file to read instead of ./.env.
MAYA_AUDIT_ENV_FILE=
# [env] Folder of the private real-site benchmark corpus (scripts/real_sites_benchmark.py; kept outside the repo).
MAYA_AUDIT_BENCHMARK_DIR=

# --- Network, reports and tools ------------------------------------------------------------------------------
# [env] "off" never sends a host name to a public DNS-over-HTTPS resolver as a fallback (default: allowed).
MAYA_AUDIT_DNS_OVER_HTTPS=
# [env] Public page that describes Maya's crawler, sent in its user agent (`--bot-info-url` default).
MAYA_AUDIT_BOT_INFO_URL=
# [env] Port of the lightweight single-file web app, maya_audit_web_lite.py (default: 8765). Leave commented unless needed.
# MAYA_LITE_PORT=
# [env] Where Playwright keeps its browsers, when not in its default cache folder.
PLAYWRIGHT_BROWSERS_PATH=
# [env] Node.js runtime for Playwright's driver, when the bundled one cannot be used.
PLAYWRIGHT_NODEJS_PATH=
